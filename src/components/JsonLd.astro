---
// Renders schema.org structured data. Not executed by browsers, so the CSP does not need to allow it.
interface Props { data: Record<string, unknown> | Record<string, unknown>[] }
const { data } = Astro.props;
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---
<script type="application/ld+json" set:html={json} />
