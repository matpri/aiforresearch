# Public values used at build time (set them in Render > Environment, not here).
# Web3Forms access key (https://web3forms.com) - leave empty to show only the email address.
PUBLIC_WEB3FORMS_KEY=
# Cloudflare Web Analytics token (cookieless) - leave empty to disable analytics.
PUBLIC_CF_ANALYTICS_TOKEN=

# Secret used ONLY by the GitHub Action that writes the weekly article.
# Store it as a GitHub repository secret named ANTHROPIC_API_KEY. Never commit it.
# ANTHROPIC_API_KEY=
